{
  "name": "lms-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config src/tests/e2e/playwright.config.ts",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "generate-assets": "node scripts/generate-assets.js",
    "preflight": "npx tsx scripts/preflight.ts",
    "env:check": "npx tsx scripts/env-check.ts",
    "db:switch": "node scripts/switch-provider.js",
    "pre-deploy": "npm run env:check && npm run preflight && npx tsc --noEmit && npm run lint && npm test && npm run build",
    "analytics:seed": "tsx scripts/seed-analytics.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.68.0",
    "@uploadthing/react": "^6.6.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.35.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-player": "^3.4.0",
    "recharts": "^3.9.2",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "uploadthing": "^6.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.1.3"
  }
}
