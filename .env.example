# ═══════════════════════════════════════════════════════════════════════
# LMS Platform — Environment Variables Template
#
# Copy this file to `.env` (local) or configure in your host (Vercel:
# Production / Preview / Development environments).
#
#   cp .env.example .env
#
# Everything below is OPTIONAL for local development except the Core Auth
# block — the app runs on the in-memory/SQLite defaults otherwise.
# ═══════════════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────────────
# SQLite (default):  file:./dev.db   (the schema hardcodes this datasource
# for local dev/tests). PostgreSQL:  postgresql://user:pass@host:5432/lms
#
#   ⚠️  Switching providers is automated:
#       node scripts/switch-provider.js postgresql   # → Postgres
#       node scripts/switch-provider.js sqlite       # → back to SQLite
#   The Vercel build (vercel.json) runs the postgresql switch automatically.
DATABASE_URL="file:./dev.db"

# NextAuth (Auth.js v5) — REQUIRED for login to work (JWT signing).
# Any local random string is fine for dev; use a strong secret in prod.
# Legacy aliases NEXTAUTH_SECRET / NEXTAUTH_URL are also accepted (the CI
# workflow uses them).
AUTH_SECRET="change-me-to-a-long-random-string"

# Canonical public URL. MUST match the port the server runs on, otherwise
# auth redirects point at a dead localhost (e.g. /admin → connection refused).
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google OAuth (social login) ─────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# (Authorized redirect: {APP_URL}/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Upstash Redis ───────────────────────────────────────────────────────
# Setting these activates persistent rate limiting (src/lib/rate-limit.ts)
# and the Redis cache layer (src/lib/cache.ts). Without them, both fall
# back to in-memory stores (per-process, reset on restart) — fine for dev.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── E-mail (Resend) ─────────────────────────────────────────────────────
# Required to actually send password-reset e-mails (src/lib/email.ts).
# Without RESEND_API_KEY, the app logs the reset link instead.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# ── File uploads (S3-compatible: AWS S3, Cloudflare R2, MinIO…) ─────────
# src/lib/upload.ts — R2 defaults to region "auto" and supports custom
# endpoints; S3_PUBLIC_URL optionally serves files via a CDN/public domain.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="lms-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Payments (Stripe) ───────────────────────────────────────────────────
# Checkout session (create-session) and webhook signature verification
# (webhook). NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is read by the client pages.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Push notifications (Web Push / VAPID) ───────────────────────────────
# Generate a keypair:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@lms.com"

# ── YouTube metadata (video lessons) ────────────────────────────────────
# With a key, /api/video/* enriches video URLs with rich metadata from the
# YouTube Data API; without it, the app falls back to basic heuristics.
YOUTUBE_API_KEY=""

# ── Observability ───────────────────────────────────────────────────────
# Sentry error tracking (only enabled in production when set).
NEXT_PUBLIC_SENTRY_DSN=""

# ── Test/CI only (not needed for local dev) ─────────────────────────────
# E2E_PRODUCTION=1 npx playwright test …   → build+start prod bundle
# E2E_BUILT=1                               → reuse an already-built bundle
# PLAYWRIGHT_PORT=3000                      → reuse a running server
# CI=true                                   → strict e2e mode (forbid only)
